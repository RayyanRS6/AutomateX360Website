# Environment variables for the booking → WhatsApp notification (api/book.ts).
# Set these in Vercel: Project → Settings → Environment Variables.
# Never commit real values. For `vercel dev`, copy this file to .env.local
# (git-ignored) and fill it in.

# WhatsApp Cloud API access token (Meta). Use a permanent System User token;
# the temporary token from the API Setup page expires after 24 hours.
WHATSAPP_TOKEN=

# "Phone number ID" of the WhatsApp Business number that sends the alerts
# (Meta App → WhatsApp → API Setup). This is an ID, not the phone number.
WHATSAPP_PHONE_NUMBER_ID=

# Your WhatsApp number(s) that receive the alerts, with country code, digits
# only. Separate several with commas, e.g. 923001234567,14155550123
WHATSAPP_NOTIFY_TO=

# Optional, recommended: name of an approved message template with 9 body
# variables (see README). Without it, a plain text message is sent, which
# WhatsApp only delivers if you've messaged the business number in the last
# 24 hours.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Optional: your time zone, so the alert shows the call time for you,
# e.g. Asia/Karachi or America/New_York. Defaults to UTC.
OWNER_TIMEZONE=

# Optional: Graph API version.
WHATSAPP_API_VERSION=v23.0
