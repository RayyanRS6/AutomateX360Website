# Environment variables for bookings (api/book.ts, api/slots.ts).
# Set these in Vercel: Project → Settings → Environment Variables.
# Never commit real values. For `vercel dev`, copy this file to .env.local
# (git-ignored) and fill it in.

# ---- GoHighLevel (availability, contacts, appointments) ----
# Private Integration Token (starts with "pit-"). Scopes needed:
# calendars.readonly, calendars/events.write, contacts.write
# (contacts.write is required: every booking creates the contact first.)
GHL_TOKEN=
# Your sub-account's Location ID (Settings → Business Profile, or the
# /location/<id>/ part of the GHL address bar).
GHL_LOCATION_ID=
# The calendar visitors book into (Calendars → Calendar settings: the id in
# the calendar's share/booking link).
GHL_CALENDAR_ID=
# Optional: the one tag added to each booked contact. Defaults to
# booking-website (the studio site uses studio-website).
GHL_TAG=
# Optional, leave empty: forces one GHL API version header for every call.
# By default contacts use 2021-07-28 and calendars 2021-04-15.
GHL_API_VERSION=

# ---- Google Sheet + WhatsApp alerts ----
# The WhatsApp agent's API key does NOT go here: it lives in the Google
# Sheet's Script Properties (see google-apps-script/Code.gs).

# Web app URL of the Google Sheet script (Deploy > Web app), ends in /exec.
SHEET_WEBHOOK_URL=
# The same long random password you saved as SHARED_SECRET in the script's
# Script Properties. The script ignores any request without it.
SHEET_SECRET=

# ---- Both ----
# Optional: your time zone for call times in the sheet, WhatsApp and GHL notes.
# Defaults to Asia/Karachi (Islamabad, Pakistan), so you can leave it empty.
OWNER_TIMEZONE=
